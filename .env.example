# Copy to .env and fill in. .env is gitignored and never enters the deployed
# export (scripts/lib/export.mjs uses `git archive HEAD`, then asserts no .env
# file rode along). Never commit real keys.
#
# Do NOT use a leading digit in a key name. `set -a; . ./.env` fails on it and
# zsh echoes the whole line, secret included, into the error output.

# ── FAQ widget ───────────────────────────────────────────────────────────────
# The name matters: app/api/chat/route.ts reads OPENAI_API_KEY exactly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── GitHub (npm run deploy creates the repo and force-pushes the export) ─────
# Classic PAT, scopes: repo, workflow. Nothing else.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Vercel (project, production deploy, domain attach) ──────────────────────
# https://vercel.com/account/tokens
VERCEL_TOKEN=
# Team slug to deploy into. ALWAYS set this. Without it the CLI falls back to
# whatever scope is cached in ~/Library/Application Support/com.vercel.cli,
# which is how a deploy silently lands in the wrong team.
VERCEL_SCOPE=yetti-dev1

# ── DNS ──────────────────────────────────────────────────────────────────────
# godaddy | cloudflare | namecheap | vercel
# "vercel" only works if the domain's nameservers are delegated to Vercel.
DNS_PROVIDER=godaddy

# GoDaddy: production key (not OTE). Since April 2026 one domain on the account
# is enough; before that it needed 10+. https://developer.godaddy.com/keys
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Cloudflare: token scoped to Zone:DNS:Edit.
# CLOUDFLARE_API_TOKEN=

# Namecheap: also requires allowlisting this machine's IP in their dashboard.
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_CLIENT_IP=

# ── Component generation (optional) ─────────────────────────────────────────
# TWENTYFIRST_API_KEY=
