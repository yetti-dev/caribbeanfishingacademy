# Supply-chain hardening for npm install. See scripts/guard.mjs for the rest.

# Quarantine freshly published versions. UNIT IS DAYS, not minutes — pnpm's
# minimumReleaseAge is minutes and the two get conflated constantly. Setting
# 1440 here does NOT mean 24 hours, it pins the whole tree to September 2022.
# 1 = only install versions at least a day old, which is long enough for the
# registry to pull most malicious releases (axios 1.14.1, the Shai-Hulud worm).
min-release-age=1

# Fail `npm install` loudly on a high or critical advisory instead of printing
# a summary nobody reads.
audit-level=high

# Install scripts are the most-abused malware hook. This machine already sets
# ignore-scripts=true in ~/.npmrc; keeping it here makes the repo self-contained
# so a colleague or a CI runner gets the same behaviour.
#
# Consequence: packages needing a native binary (unrs-resolver via
# eslint-config-next) will not fetch it, so `npm run lint` may fail on a fresh
# clone. Run `npm rebuild <pkg>` for that one package after reviewing it.
# `npm run guard` blocks on any NEW install script, which is the check that
# actually catches a compromised release.
ignore-scripts=true

fund=false
